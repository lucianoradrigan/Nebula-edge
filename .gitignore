# Build esp32
.vscode/
esp32.code-workspace
nebulaedge.code-workspace

# ESP-IDF
esp32/.venv/
esp32/vscode/
esp32/build/
esp32/sdkconfig
esp32/sdkconfig.old
esp32/components/**/build/
esp32/components/**/log/
# Los baja idf.py desde el registro de componentes (esp-tflite-micro, esp-nn).
# La versión exacta queda fijada en esp32/dependencies.lock, que sí se versiona.
esp32/managed_components/

# Server
# Credenciales reales de la base. La plantilla versionada es raspberry/.env.example
raspberry/.env
raspberry/__pycache__/
raspberry/server/venv/
raspberry/**/__pycache__/
raspberry/deprecated-testing/
raspberry/server/requirements.txt

# macOS
.DS_Store
.AppleDouble
.LSOverride
# CMake suelto en la raíz (idf.py lanzado desde el repo, no desde esp32/)
/build/

# Entorno virtual de Python (local, no versionado)
raspberry/.venv/

# ML: se versiona el código (*.py), no lo que produce.
# archive/ es el dataset GC-FL (47 GB); .venv/ es TensorFlow (1,8 GB).
ml/.venv/
ml/archive/
ml/**/__pycache__/
ml/*.keras
ml/*.npz
ml/*.tflite
ml/*_data.cc
ml/*_data.h
# INSERTs de export_model.py y export_testset.py: llevan el modelo entero en
# hex, o miles de ventanas crudas (testset_*.sql pesa ~20 MB).
ml/*_v*.sql
ml/testset_*.sql
