# This file was generated using idf.py save-defconfig. It can be edited manually.
# Espressif IoT Development Framework (ESP-IDF) Project Minimal Configuration

# Set esp32s3 como default
CONFIG_IDF_TARGET="esp32s3"

CONFIG_BT_ENABLED=y
CONFIG_BT_BLE_50_FEATURES_SUPPORTED=n
CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y
CONFIG_BT_LE_50_FEATURE_SUPPORT=n

# Para mostrar información de tasks
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_USE_STATS_FORMATTING_FUNCTIONS=y
CONFIG_FREERTOS_UNICORE=y

# Frecuencia de ticks (1000 hz -> cada 1 ms)
CONFIG_FREERTOS_HZ=100

# FreeRTOS: detección de overflow de pila
CONFIG_FREERTOS_CHECK_STACKOVERFLOW_CANARY=y

# Poner watchpoint al final de la pila de cada task
CONFIG_FREERTOS_WATCHPOINT_END_OF_STACK=y

# Aumenta el tamaño de la pila
CONFIG_ESP_MAIN_TASK_STACK_SIZE=10000

# Permite nombres de archivos largos 
CONFIG_FATFS_LFN_NONE=n
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_LFN_STACK=y

# Ajusta Watchdog timer. Default es 300
# CONFIG_ESP_INT_WDT_TIMEOUT_MS=2400

# Ajusta memoria flash a 16MB
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# Tabla de particiones propia (partitions.csv): el preset SINGLE_APP_LARGE fija
# la app en 1500K y no crece con el tamaño de la flash. Ese preset se quitó de
# más arriba en este archivo: las dos opciones son de la misma `choice` de
# Kconfig, y tenerlas ambas en =y solo funcionaba porque la de abajo gana por
# orden de aparición.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
