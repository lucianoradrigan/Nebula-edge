# Credenciales de Postgres, compartidas por los dos servicios de
# docker-compose.yml: el contenedor de la base las usa para crearse
# (POSTGRES_*) y el servidor para conectarse (system.py -> database_dsn()).
#
# USO
#     cp .env.example .env    y editar .env
#
# Sin .env, compose cae a estos mismos valores, así que clonar el repo y
# levantarlo sigue funcionando en un comando.
#
# .env está en .gitignore. Este archivo NO: es la plantilla, y no debe tener
# credenciales reales.
PG_HOST=localhost
PG_DB=nebulaedge
PG_USER=nebulaedge
PG_PASSWORD=1234

# Red WiFi que el servidor le entrega a los devices (system.py ->
# LocalWifiConfig). Vacías = se lee con nmcli la red de la Pi en WIFI_DEVICE,
# sea una WiFi a la que está conectada o un AP que levantó ella misma.
#
# Con la Pi por ethernet a un router aparte, la Pi no está en ninguna WiFi:
# hay que poner acá el SSID y la contraseña de ese router. HOST_IP puede
# quedar vacía: se detecta la IP de la interfaz con salida a la red.
WIFI_SSID=
WIFI_PASSWD=
HOST_IP=
WIFI_DEVICE=wlan0
