# Credenciales de Postgres, compartidas por los dos servicios de
# docker-compose.yml: el contenedor de la base las usa para crearse
# (POSTGRES_*) y el servidor para conectarse (system.py -> database_dsn()).
#
# USO
#     cp .env.example .env    y editar .env
#
# Sin .env, compose cae a estos mismos valores, así que clonar el repo y
# levantarlo sigue funcionando en un comando.
#
# .env está en .gitignore. Este archivo NO: es la plantilla, y no debe tener
# credenciales reales.
PG_HOST=localhost
PG_DB=nebulaedge
PG_USER=nebulaedge
PG_PASSWORD=1234

# Red WiFi que el servidor le entrega a los devices (system.py -> LocalWifiConfig).
# Obligatorias si algún device usa UDP, TCP, MQTT o INFER:
#   - Pi en modo AP: el SSID y la clave del AP que publica la Pi (los mismos con
#     que se creó su perfil, README 10.1).
#   - Pi como cliente de un router, o por cable a él: los del router.
# HOST_IP puede quedar vacía: se usa la IPv4 de WIFI_DEVICE, y si no tiene, la
# de la ruta por defecto. Con el AP es 10.42.0.1.
# Al cambiar de red hay que subir config_version de cada device (README 10).
WIFI_SSID=
WIFI_PASSWD=
HOST_IP=
# Interfaz de la que se toma la IP del servidor. Con el AP en un dongle WiFi USB,
# la del dongle (wlan_ap).
WIFI_DEVICE=wlan0

# Adaptador BLE. auto = el dongle USB si hay, si no el de la placa. Un nombre
# (hci0, hci1) lo fuerza.
BLE_ADAPTER=auto

# Cada cuánto el servidor le pone la hora a cada device, en segundos. 0 = nunca:
# solo para medir la deriva del reloj del device corriendo libre.
CLOCK_RESYNC_SEC=300
